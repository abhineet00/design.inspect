{
  "manifest_version": 3,
  "name": "InspectCSS — Visual CSS Editor",
  "version": "0.1.0",
  "description": "Hover to highlight, click to select, edit CSS live on any website, and copy clean generated CSS.",
  "action": {
    "default_title": "Toggle InspectCSS"
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
